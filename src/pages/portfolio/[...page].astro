---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Card, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getCollection('projects')

  // Ordenar proyectos por ID/nombre descendente (más reciente primero)
  const sortedProjects = projects.sort((a, b) => b.id.localeCompare(a.id))

  const projectsWithImages = sortedProjects.map((project) => {
    return {
      ...project,
      featuredImage: '/projects/dashboard.png',
    }
  })

  return paginate(projectsWithImages, { pageSize: 6 })
}) satisfies GetStaticPaths

interface Props { page: Page<CollectionEntry<'projects'> & { featuredImage: string }> }

const { page } = Astro.props
---

<DefaultLayout
  title="Portfolio"
  description="Mis proyectos de desarrollo Android y Web, donde combino creatividad y lógica para crear soluciones reales."
>
  <PageHeader
    title="Portfolio"
    subtitle='Una colección de mis proyectos de desarrollo, incluyendo aplicaciones Android en Java y desarrollos web. Cada proyecto representa un reto técnico y creativo que he disfrutado construir.'
    bgType="bordered"
  />
  <section class="my-12">
    <div class="container">
      <p class="text-sm"><em>Proyecto {page.start + 1} al {page.end + 1} de {page.total} proyectos totales</em></p>
      <ul class="my-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((project) => (
            <li>
              <Card
                imageUrl={project.featuredImage}
                url={'/portfolio/' + project.id}
                title={project.data.title}
                headingLevel="h2"
                footer={'Autor: ' + project.data.author}
                fullHeight={true}
              >
                {project.data.description}
              </Card>
            </li>
          ))
        }
      </ul>
      <div class="mt-12 grid place-content-center">
        <Pagination
          firstPage={page.url.prev ? '/portfolio' : null}
          previousPage={page.url.prev ? page.url.prev : null}
          nextPage={page.url.next ? page.url.next : null}
          lastPage={page.url.next ? `/portfolio/${Math.ceil(page.total / page.size)}` : null}
          currentPage={`${page.currentPage}`}
          totalPages={`${Math.ceil(page.total / page.size)}`}
          ariaLabel="Portfolio pagination"
        />
      </div>
    </div>
  </section>
</DefaultLayout>
