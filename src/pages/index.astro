---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
// eslint-disable-next-line no-unused-vars
import { Accordion, AccordionItem, Heading } from 'accessible-astro-components'
import ContentMedia from '@components/ContentMedia.astro'

---

<DefaultLayout title="Inicio · Julia | Android & Web">
  <!-- HERO (sin correo: no paso secondaryHref / secondaryText) -->
  <Hero 
    src="/here-img.webp"
    alt="Retrato de Julia, desarrolladora Android y Web"
    title="Hola, soy Julia"
    subtitle="Desarrolladora que disfruta el desafío de convertir lógica compleja en aplicaciones simples de usar."
    primaryHref="/portfolio"
    primaryText="Ver proyectos"
  />

  <!-- TECNOLOGÍAS Y HERRAMIENTAS -->
  <section class="my-64">
  <div class="container">
    <Heading level="h2" class="mb-8">Tecnologías y herramientas</Heading>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">

      <Feature icon="lucide:code-xml" title="Lenguajes">
        Java · PHP · Python · C# · Dart · HTML · CSS/SCSS · SQL
      </Feature>

      <Feature icon="lucide:boxes" title="Frameworks / Librerías">
        JavaFX · Spring Boot · Hibernate · Flutter
      </Feature>

      <Feature icon="lucide:database" title="Bases de datos">
        OracleDB · SQLite · Firebase
      </Feature>

      <Feature icon="lucide:smartphone" title="Android">
        Android Studio (Java) · Material · consumo de APIs · persistencia local
      </Feature>

      <Feature icon="lucide:globe-2" title="Web">
        HTML · CSS/SCSS · JavaScript · GitHub Pages (CI con Actions)
      </Feature>

      <Feature icon="lucide:wrench" title="Herramientas y control de versiones">
        Git · GitHub · Docker · Composer · Maven · IntelliJ IDEA
      </Feature>

    </div>
  </div>
</section>



  <!-- BLOQUES EXPLICATIVOS -->

  <ContentMedia imgSrc="/wcag-compliant.webp" reverseImg={true}>
  <Heading level="h2">Sobre mí</Heading>
  <p class="text-2xl">
    Desarrolladora Android y Web. Creo aplicaciones donde la lógica y el diseño se complementan para resolver problemas reales.

    Formación: Técnica Superior en Desarrollo de Aplicaciones Multiplataforma. Experiencia en proyectos móviles (Java, Android Studio) y web (full-stack).

    Me impulsa la curiosidad por entender cómo funcionan las cosas y la satisfacción de construir software útil.
  </p>
</ContentMedia>

  

  <!-- PROYECTOS / BLOG -->
  <FeaturedProjects />
  <FeaturedPosts />

  <!-- FAQ -->
  

  <!-- MÉTRICAS (ajústalas cuando quieras) -->
 
</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
