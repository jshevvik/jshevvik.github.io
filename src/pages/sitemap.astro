---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
const posts = await getCollection('blog', ({ data }) => !data.draft)

const staticPages = [
  { title: 'Inicio', url: '/', description: 'Presentación, especialidades y recorrido profesional de Julia.' },
  { title: 'Portfolio', url: '/portfolio/', description: 'Proyectos y casos de estudio de desarrollo.' },
  { title: 'Sobre mí', url: '/about-me', description: 'Formación, experiencia y transición hacia el desarrollo frontend.' },
  { title: 'Blog', url: '/blog/', description: 'Artículos y notas sobre desarrollo, accesibilidad y aprendizaje.' },
  { title: 'Contacto', url: '/contact/', description: 'Vías de contacto profesional y enlaces de Julia.' },
  { title: 'Accesibilidad', url: '/accessibility-statement/', description: 'Compromiso y medidas de accesibilidad del sitio.' },
]
---

<DefaultLayout title="Mapa del sitio" description="Páginas, proyectos y artículos disponibles en el portfolio de Julia Shevchenko.">
  <PageHeader
    title="Mapa del sitio"
    subtitle="Una vista organizada de las páginas, proyectos y artículos disponibles."
    bgType="bordered"
  />

  <section class="sitemap-section">
    <div class="container sitemap-grid">
      <div>
        <Heading level="h2">Páginas principales</Heading>
        <ul>
          {staticPages.map((page) => (
            <li>
              <a href={page.url}>{page.title}</a>
              <p>{page.description}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <Heading level="h2">Proyectos</Heading>
        <ul>
          {projects.map((project) => (
            <li>
              <a href={`/portfolio/${project.id}/`}>{project.data.title}</a>
              <p>{project.data.description}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <Heading level="h2">Artículos</Heading>
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`}>{post.data.title}</a>
              {post.data.description && <p>{post.data.description}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .sitemap-section { padding-block: clamp(4rem, 8vw, 8rem); }
  .sitemap-grid { display: grid; gap: 3rem; }
  h2 { margin-bottom: 1.25rem; color: #eff8fa; font-size: clamp(1.65rem, 3vw, 2.4rem); }
  ul { display: grid; gap: 1rem; }
  li { border-top: 1px solid rgb(130 181 198 / .18); padding-top: 1rem; }
  a { color: #78e8da; font-weight: 600; text-underline-offset: .25rem; }
  p { margin-top: .35rem; max-width: 50rem; color: #93aab6; line-height: 1.55; }
  @media (min-width: 56rem) { .sitemap-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
