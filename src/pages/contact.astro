---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Contacto · Julia Shevchenko" description="Contacto profesional con Julia Shevchenko, desarrolladora de software junior con experiencia en Java y desarrollo web.">
  <PageHeader
    title="Hablemos"
    subtitle="Si buscas una desarrolladora junior con curiosidad, criterio y ganas de aportar en un proyecto real, me encantará conoceros."
    bgType="bordered"
  />

  <section class="contact-page" aria-labelledby="contact-options">
    <div class="container contact-page__grid">
      <div>
        <p class="kicker">Contacto profesional</p>
        <h2 id="contact-options">Una buena colaboración empieza con una conversación clara.</h2>
      </div>
      <div class="contact-page__options">
        <a href="https://github.com/jshevvik" target="_blank" rel="me noreferrer">
          <span><Icon aria-hidden="true" name="lucide:github" size="1.35rem" /> GitHub</span>
          <Icon aria-hidden="true" name="lucide:arrow-up-right" size="1.2rem" />
          <small>Explora mi código y proyectos públicos</small>
        </a>
        <a href="/portfolio/">
          <span><Icon aria-hidden="true" name="lucide:folder-code" size="1.35rem" /> Portfolio</span>
          <Icon aria-hidden="true" name="lucide:arrow-right" size="1.2rem" />
          <small>Conoce cómo abordo un producto completo</small>
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .contact-page { padding-block: clamp(5rem, 10vw, 10rem); }
  .contact-page__grid { display: grid; gap: 3rem; }
  .kicker { margin-bottom: 1rem; color: #73e7d8; font-weight: 600; font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; }
  h2 { max-width: 14ch; color: #eff9fb; font-size: clamp(2.4rem, 5vw, 5rem); line-height: 1; letter-spacing: -.045em; }
  .contact-page__options { border-top: 1px solid rgb(130 181 198 / .2); }
  .contact-page__options a { display: grid; grid-template-columns: 1fr auto; gap: .5rem 1rem; border-bottom: 1px solid rgb(130 181 198 / .2); padding-block: 1.5rem; color: #eef8fa; text-decoration: none; }
  .contact-page__options a > span { display: flex; align-items: center; gap: .65rem; font-size: 1.25rem; font-weight: 600; }
  .contact-page__options small { grid-column: 1 / -1; color: #829dab; font-size: .9rem; }
  @media (min-width: 48rem) { .contact-page__grid { grid-template-columns: 1fr .8fr; align-items: start; gap: 6rem; } }
</style>
