---
import ResponsiveToggle from './ResponsiveToggle.astro'
import Logo from './Logo.astro'
---

<div id="main-navigation">
  <div class="container navigation__inner">
    <Logo />
    <nav class="desktop-menu" aria-label="Navegación principal">
      <ul class="menu"><slot /></ul>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>
    <ResponsiveToggle />
    <nav id="mobile-navigation" class="mobile-menu" aria-label="Navegación móvil">
      <ul class="menu"><slot /></ul>
    </nav>
  </div>
</div>

<style lang="scss" is:global>
  #main-navigation {
    .navigation__inner { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 5.5rem; transition: min-height 350ms cubic-bezier(.2,.75,.2,1); }
    .navigation__inner > a { position: relative; z-index: 2; color: #eff9fb; text-decoration: none; }
    .navigation__inner > a img { width: 2.25rem; height: auto; transition: transform 300ms cubic-bezier(.2,.8,.2,1); }
    .navigation__inner > a:hover img, .navigation__inner > a:focus-visible img { transform: rotate(-5deg) scale(1.06); }
    .navigation__inner > a span { font-size: 1rem; letter-spacing: .01em; }
    .desktop-menu { position: relative; padding-block: .5rem; }
    .menu { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2rem); }
    .menu a { display: inline-flex; align-items: center; gap: .35rem; color: #b6c9d2; font-size: .95rem; text-decoration: none; transition: color 200ms ease; }
    .menu a:hover, .menu a:focus-visible, .menu a.is-active { color: #f0fafb; }
    .nav-indicator { position: absolute; bottom: 0; left: 0; width: var(--indicator-width, 0); height: 2px; border-radius: 999px; opacity: 0; transform: translateX(var(--indicator-x, 0)); background: linear-gradient(90deg, #70e6d7, #9af5eb); box-shadow: 0 0 .75rem rgb(112 230 215 / .55); transition: width 320ms cubic-bezier(.2,.8,.2,1), transform 320ms cubic-bezier(.2,.8,.2,1), opacity 200ms ease; }
    .nav-indicator.is-ready { opacity: 1; }
    .nav-indicator.is-immediate { transition: none; }
    .menu-item--contact a { position: relative; overflow: hidden; border: 1px solid rgb(113 231 216 / .45); border-radius: 999px; padding: .6rem 1rem; color: #77e9db; isolation: isolate; transition: color 220ms ease, border-color 220ms ease, transform 220ms cubic-bezier(.2,.8,.2,1); }
    .menu-item--contact a::before { position: absolute; z-index: -1; inset: 0; transform: translateY(105%); background: #77e9db; content: ''; transition: transform 260ms cubic-bezier(.2,.8,.2,1); }
    .menu-item--contact a svg { transition: transform 260ms cubic-bezier(.2,.8,.2,1); }
    .menu-item--contact a:hover, .menu-item--contact a:focus-visible { border-color: #77e9db; color: #05221f; transform: translateY(-1px); }
    .menu-item--contact a:hover::before, .menu-item--contact a:focus-visible::before { transform: translateY(0); }
    .menu-item--contact a:hover svg, .menu-item--contact a:focus-visible svg { transform: translate(.18rem, -.18rem); }

    .mobile-menu { position: absolute; top: calc(100% - .25rem); right: 0; left: 0; overflow: hidden; max-height: 0; border: 1px solid transparent; border-radius: 0 0 1rem 1rem; padding-inline: var(--grid-gutter); visibility: hidden; opacity: 0; transform: translateY(-.75rem); background: rgb(4 17 30 / .96); box-shadow: 0 1.5rem 3rem rgb(0 5 12 / .3); pointer-events: none; transition: max-height 450ms cubic-bezier(.2,.75,.2,1), opacity 250ms ease, transform 350ms cubic-bezier(.2,.75,.2,1), visibility 0s linear 450ms, padding 350ms ease, border-color 350ms ease; backdrop-filter: blur(18px); }
    .mobile-menu.show { max-height: min(31rem, calc(100vh - 6rem)); border-color: rgb(137 187 203 / .17); padding-block: 1.2rem 1.5rem; visibility: visible; opacity: 1; transform: translateY(0); pointer-events: auto; transition-delay: 0s; }
    .mobile-menu .menu { align-items: stretch; flex-direction: column; gap: .2rem; }
    .mobile-menu .menu-item { opacity: 0; transform: translateY(-.6rem); transition: opacity 280ms ease, transform 350ms cubic-bezier(.2,.75,.2,1); }
    .mobile-menu.show .menu-item { opacity: 1; transform: translateY(0); transition-delay: calc(70ms + var(--menu-index, 0) * 55ms); }
    .mobile-menu .menu-item:nth-child(1) { --menu-index: 0; }
    .mobile-menu .menu-item:nth-child(2) { --menu-index: 1; }
    .mobile-menu .menu-item:nth-child(3) { --menu-index: 2; }
    .mobile-menu .menu-item:nth-child(4) { --menu-index: 3; }
    .mobile-menu .menu-item:nth-child(5) { --menu-index: 4; }
    .mobile-menu .menu a { display: flex; min-height: 3rem; padding: .65rem .25rem; font-size: 1.08rem; }
    .mobile-menu .menu-item--contact a { justify-content: center; margin-top: .55rem; width: 100%; }
    .responsive-toggle { display: none; }
  }

  .site-header.is-scrolled #main-navigation .navigation__inner { min-height: 4.5rem; }

  @media (max-width: 47.99rem) {
    #main-navigation .navigation__inner { flex-wrap: wrap; min-height: 4.75rem; }
    #main-navigation .desktop-menu { display: none; }
    #main-navigation .responsive-toggle { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    #main-navigation .navigation__inner, #main-navigation .navigation__inner > a img, #main-navigation .nav-indicator, #main-navigation .menu-item--contact a, #main-navigation .menu-item--contact a::before, #main-navigation .menu-item--contact a svg, #main-navigation .mobile-menu, #main-navigation .mobile-menu .menu-item { transition: none; }
  }
</style>
