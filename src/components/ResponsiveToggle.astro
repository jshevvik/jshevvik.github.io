---
interface Props { class?: string }
const { class: className } = Astro.props
---

<button class:list={[className, 'responsive-toggle']} aria-expanded="false" aria-label="Abrir navegación" aria-controls="mobile-navigation">
  <span>Menú</span>
  <span class="responsive-toggle__icon" aria-hidden="true"><i></i><i></i><i></i></span>
</button>

<style lang="scss">
  .responsive-toggle { align-items: center; gap: .65rem; min-width: 2.75rem; min-height: 2.75rem; border: 0; border-radius: .65rem; padding: .5rem; background: transparent; color: #dcecef; }
  .responsive-toggle > span:first-child { font-size: .9rem; }
  .responsive-toggle__icon { display: grid; gap: .28rem; width: 1.5rem; }
  .responsive-toggle__icon i { display: block; width: 100%; height: 2px; border-radius: 999px; background: currentColor; transform-origin: center; transition: transform 250ms cubic-bezier(.2,.8,.2,1), opacity 180ms ease; }
  .responsive-toggle.is-open .responsive-toggle__icon i:nth-child(1) { transform: translateY(.4rem) rotate(45deg); }
  .responsive-toggle.is-open .responsive-toggle__icon i:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .responsive-toggle.is-open .responsive-toggle__icon i:nth-child(3) { transform: translateY(-.4rem) rotate(-45deg); }
  .responsive-toggle:hover, .responsive-toggle:focus-visible { background: rgb(112 230 215 / .08); color: #8df1e5; }
  @media (prefers-reduced-motion: reduce) { .responsive-toggle__icon i { transition: none; } }
</style>
